OPENAI_API_KEY=sk-proj-your-key-here

# Generator model: writes the plan, the grounding-loop answer, and the Contradiction Finder's reasoning.
GENERATOR_MODEL=gpt-4o

# Judge model: used ONLY by the verifier/scope-gate (Section 7) so it is never grading its own output.
# Left as a separate, smaller/cheaper model by default -- revisit once real eval data exists (Section 7).
JUDGE_MODEL=gpt-4o-mini
