OPENAI_API_KEY=sk-proj-your-key-here

# Generator model: writes the plan, the grounding-loop answer, and the Contradiction Finder's reasoning.
GENERATOR_MODEL=gpt-4o

# Judge model: used ONLY by the verifier/scope-gate (Section 7) so it is never grading its own output.
# Left as a separate, smaller/cheaper model by default -- revisit once real eval data exists (Section 7).
JUDGE_MODEL=gpt-4o-mini

# Postgres+pgvector corpus index (Section 10). Matches docker-compose.yml's local dev defaults.
DATABASE_URL=postgresql://immigration_navigator:local_dev_only@localhost:5432/immigration_navigator

# Embedding model used to build and query the corpus vector index.
EMBEDDING_MODEL=text-embedding-3-small
